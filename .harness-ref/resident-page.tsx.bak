'use client';

import { useEffect } from 'react';
import { useRouter } from 'next/navigation';

export default function ResidentRedirect() {
  const router = useRouter();

  useEffect(() => {
    router.replace('/');
  }, [router]);

  return (
    <div className="py-20 text-center text-xs text-relay-slate-400">
      Loading Resident Command Center...
    </div>
  );
}
