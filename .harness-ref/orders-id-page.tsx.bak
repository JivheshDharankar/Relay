'use client';

import React, { useEffect, useState } from 'react';
import Link from 'next/link';
import { useParams } from 'next/navigation';
import { Container, Badge, Button } from '@/components/ui';
import { getOrders } from '@/lib/api';
import { PortalOrder } from '@/types';
import {
  ArrowLeft,
  Package,
  Truck,
  CreditCard,
  ShieldCheck,
  CheckCircle2,
  Clock,
  Building2,
  MapPin,
  Scale,
  FileText,
} from 'lucide-react';

export default function OrderDetailPage() {
  const params = useParams();
  const orderId = params?.id as string;

  const [order, setOrder] = useState<PortalOrder | null>(null);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    async function fetchOrder() {
      try {
        const allOrders = await getOrders();
        const matched = allOrders.find((o) => o.id === orderId);
        setOrder(matched || null);
      } catch (err) {
        console.error('Failed to load order detail', err);
      } finally {
        setLoading(false);
      }
    }
    if (orderId) {
      fetchOrder();
    }
  }, [orderId]);

  if (loading) {
    return (
      <div className="py-16 text-center text-xs text-relay-slate-400">
        Loading order details...
      </div>
    );
  }

  if (!order) {
    return (
      <div className="py-16">
        <Container size="md">
          <div className="bg-white rounded-2xl border border-relay-slate-200 p-8 text-center space-y-4">
            <h2 className="text-base font-bold text-relay-slate-900">
              Order Not Found
            </h2>
            <p className="text-xs text-relay-slate-500">
              Could not find order with reference ID: {orderId}
            </p>
            <Link href="/orders">
              <Button size="sm" variant="outline" className="text-xs">
                Back to Orders
              </Button>
            </Link>
          </div>
        </Container>
      </div>
    );
  }

  const cleanOrderId = `ORD-${order.id.replace(/-/g, '').slice(0, 8).toUpperCase()}`;
  const orderDate = new Date(order.requestedAt).toLocaleDateString('en-IN', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  });

  const isDelivered =
    order.status === 'DELIVERED' ||
    order.communityOrder?.deliveryStatus === 'DELIVERED' ||
    order.communityOrder?.status === 'DELIVERED';
  const isPaid = order.status === 'PAID';

  return (
    <div className="py-8 sm:py-10 space-y-6">
      <Container size="md">
        {/* Navigation & Title */}
        <div className="space-y-3 pb-4 border-b border-relay-slate-200">
          <Link
            href="/orders"
            className="inline-flex items-center gap-1.5 text-xs text-relay-slate-500 hover:text-relay-slate-900 font-medium transition-colors"
          >
            <ArrowLeft className="h-3.5 w-3.5" />
            <span>Back to All Orders</span>
          </Link>

          <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div>
              <div className="flex items-center gap-2 mb-1">
                <span className="font-mono text-xs font-bold text-relay-slate-900">
                  {cleanOrderId}
                </span>
                <span className="text-relay-slate-300">•</span>
                <span className="text-xs text-relay-slate-500">{orderDate}</span>
              </div>
              <h1 className="text-xl sm:text-2xl font-bold tracking-tight text-relay-slate-900">
                Unit Procurement Record
              </h1>
            </div>

            <div className="flex items-center gap-2">
              <span
                className={`inline-flex items-center gap-1.5 text-xs px-3 py-1 rounded-full font-semibold border ${
                  isDelivered
                    ? 'bg-emerald-50 text-emerald-700 border-emerald-200'
                    : isPaid
                    ? 'bg-blue-50 text-blue-700 border-blue-200'
                    : 'bg-relay-slate-100 text-relay-slate-700 border-relay-slate-200'
                }`}
              >
                {isDelivered && <CheckCircle2 className="h-3.5 w-3.5" />}
                {isPaid && !isDelivered && <Clock className="h-3.5 w-3.5" />}
                <span>{isDelivered ? 'Delivered' : isPaid ? 'Settled' : order.status}</span>
              </span>
            </div>
          </div>
        </div>

        {/* 1. Items Purchased Card */}
        <div className="bg-white rounded-2xl border border-relay-slate-200/90 shadow-subtle p-5 sm:p-6 space-y-4">
          <div className="flex items-center gap-2 pb-2 border-b border-relay-slate-100">
            <Package className="h-4 w-4 text-relay-accent" />
            <h2 className="text-sm font-bold text-relay-slate-900 tracking-tight">
              Procured Goods
            </h2>
          </div>

          <div className="divide-y divide-relay-slate-100 text-xs">
            {order.items.map((item) => (
              <div key={item.id} className="py-3 flex items-center justify-between gap-3">
                <div>
                  <span className="font-semibold text-relay-slate-900 block text-sm">
                    {item.productName}
                  </span>
                  <span className="text-relay-slate-500 font-mono">
                    {item.quantity} {item.unit} @ ₹{item.unitPrice.toFixed(2)}/{item.unit} wholesale
                  </span>
                </div>
                <div className="text-right font-mono font-bold text-sm text-relay-slate-900">
                  ₹{item.totalPrice.toFixed(2)}
                </div>
              </div>
            ))}
          </div>

          <div className="pt-3 border-t border-relay-slate-200 flex items-center justify-between font-mono">
            <span className="text-xs font-semibold text-relay-slate-600">
              Order Total (Inclusive of Wholesale Delivery)
            </span>
            <span className="text-lg font-bold text-relay-slate-900">
              ₹{order.totalAmount.toFixed(2)}
            </span>
          </div>
        </div>

        {/* 2. Settlement & Mandate Card */}
        <div className="bg-white rounded-2xl border border-relay-slate-200/90 shadow-subtle p-5 sm:p-6 space-y-3">
          <div className="flex items-center gap-2 pb-2 border-b border-relay-slate-100">
            <CreditCard className="h-4 w-4 text-relay-accent" />
            <h2 className="text-sm font-bold text-relay-slate-900 tracking-tight">
              Pre-Authorized Settlement
            </h2>
          </div>

          <div className="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
            <div className="p-3 rounded-xl bg-relay-slate-50 border border-relay-slate-200">
              <span className="text-[10px] text-relay-slate-400 font-bold uppercase block">
                Payment Status
              </span>
              <span className="font-semibold text-emerald-700 block mt-0.5">
                {order.payment?.status || (isPaid ? 'SUCCESS' : 'PENDING')}
              </span>
            </div>

            <div className="p-3 rounded-xl bg-relay-slate-50 border border-relay-slate-200">
              <span className="text-[10px] text-relay-slate-400 font-bold uppercase block">
                Settled Amount
              </span>
              <span className="font-mono font-bold text-relay-slate-900 block mt-0.5">
                ₹{order.payment?.amount?.toFixed(2) || order.totalAmount.toFixed(2)}
              </span>
            </div>

            <div className="p-3 rounded-xl bg-relay-slate-50 border border-relay-slate-200">
              <span className="text-[10px] text-relay-slate-400 font-bold uppercase block">
                Transaction Reference
              </span>
              <span className="font-mono text-relay-slate-700 block mt-0.5 truncate">
                {order.payment?.providerReference || 'MOCK-TXN-VERIFIED'}
              </span>
            </div>
          </div>
        </div>

        {/* 3. Community Fulfillment & Gate Tracking */}
        {order.communityOrder && (
          <div className="bg-white rounded-2xl border border-relay-slate-200/90 shadow-subtle p-5 sm:p-6 space-y-3">
            <div className="flex items-center gap-2 pb-2 border-b border-relay-slate-100">
              <Truck className="h-4 w-4 text-relay-accent" />
              <h2 className="text-sm font-bold text-relay-slate-900 tracking-tight">
                Consolidated Community Order
              </h2>
            </div>

            <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
              <div className="p-3 rounded-xl bg-relay-slate-50 border border-relay-slate-200 space-y-1">
                <span className="text-[10px] text-relay-slate-400 font-bold uppercase block">
                  Wholesale Supplier
                </span>
                <span className="font-semibold text-relay-slate-900 block">
                  {order.communityOrder.supplierName}
                </span>
                <span className="text-relay-slate-500 text-[11px] block">
                  Direct B2B Community Dispatch
                </span>
              </div>

              <div className="p-3 rounded-xl bg-relay-slate-50 border border-relay-slate-200 space-y-1">
                <span className="text-[10px] text-relay-slate-400 font-bold uppercase block">
                  Gate Delivery Status
                </span>
                <span className="font-semibold text-emerald-700 block">
                  {order.communityOrder.deliveryStatus}
                </span>
                <span className="text-relay-slate-500 font-mono text-[11px] block">
                  {order.communityOrder.trackingCode || 'TRK-SIM-COMPLETED'}
                </span>
              </div>
            </div>
          </div>
        )}

        {/* 4. Audit & Invariant Assurance */}
        <div className="p-4 rounded-xl bg-relay-slate-900 text-white flex items-center justify-between gap-3 text-xs">
          <div className="flex items-center gap-2">
            <ShieldCheck className="h-4 w-4 text-emerald-400 shrink-0" />
            <span className="text-relay-slate-200 font-medium">
              Three-way financial reconciliation verified: Zero drift across order, allocation, and invoice.
            </span>
          </div>
          <span className="font-mono text-emerald-300 font-bold text-[11px] shrink-0">
            AUDITED
          </span>
        </div>
      </Container>
    </div>
  );
}

